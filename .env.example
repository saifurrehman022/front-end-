# Public URL of the live site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://echoloftai.com

# FastAPI backend (auth)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Contact form endpoint (Formspree / Web3Forms / your own API). If empty, the form opens the visitor's email app instead.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional: Google Search Console verification token
NEXT_PUBLIC_GOOGLE_VERIFICATION=
